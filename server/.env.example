# Copy to server/.env (git-ignored) or set these in the environment.
#
# JWT_SECRET signs session cookies. Required in production — the API refuses
# to start without it. In development, server/secret.js generates one into
# server/.env on first boot, so you can usually leave this alone.
#
# Generate a fresh value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it signs every user out.
JWT_SECRET=

# NODE_ENV=production enables the strict checks above.
# NODE_ENV=production

# P-032: optional. Enables Unsplash city cover photos; without it Kite keeps
# its gradient covers. Free key from https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# P-045: optional. Enables "Continue with Google"; without both values the
# button never appears and email/password sign-in is unaffected.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# (type: Web application) and register the redirect URI:
#   http://localhost:4000/api/auth/google/callback   (development)
#   https://<your-domain>/api/auth/google/callback   (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Needed in production so the redirect URI matches what Google has registered
# rather than being taken from a request header.
# KITE_BASE_URL=https://kite.fly.dev
